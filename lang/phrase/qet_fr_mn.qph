    <source>Clic gauche : positionner le point final (Ctrl = position libre) ; clic droit : annuler</source>
    <target>Зүүн дар: төгсгөлийн цэгийг байрлуулах (Ctrl = чөлөөт байрлал); баруун дар: цуцлах</target>
</phrase>
