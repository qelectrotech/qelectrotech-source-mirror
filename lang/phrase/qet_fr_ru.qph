    <source>Clic gauche : positionner le coin opposé (Maj = carré, Ctrl = depuis le centre + position libre, Ctrl+Maj = carré centré) ; clic droit : annuler</source>
    <target>Левый щелчок: установить противоположный угол (Shift = квадрат, Ctrl = от центра + свободное положение, Ctrl+Shift = квадрат от центра); правый щелчок: отменить</target>
</phrase>
