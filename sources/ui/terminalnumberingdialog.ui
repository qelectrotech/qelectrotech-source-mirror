        <layout class="QVBoxLayout" name="verticalLayout">
            <item>
                <widget class="QLabel" name="label_description">
                    <property name="text">
                        <string>This function numbers the terminals in the project according to their position. Empty or locked terminals are ignored. Terminal labelling must be configured in advance as follows : '-X:AB'. The part before the colon (the terminal block) can be named as desired. 'AB' can consist of numbers or letters."</string>
                    </property>
                    <property name="wordWrap">
                        <bool>true</bool>
                    </property>
                </widget>
