    </grid>
</titleblocktemplate>
    </titleblocktemplates>
    <newdiagrams>
        <border rowsize="80" rows="13" displaycols="true" cols="27" colsize="58" displayrows="true"/>
        <inset titleblocktemplate="ISO7200 A3" titleblocktemplateCollection="embedded" displayAt="bottom" folio="%id/%total" indexrev="" plant="" date="null" filename="" author="" locmach="" title="" version="" auto_page_num="Folio"/>
        <report label="%f-%l%c"/>
        <conductors_autonums freeze_new_conductors="false" current_autonum="IEC wires">
            <conductor_autonum formula="%id-%sequf_1" title="IEC wires">
                <part increase="1" value="" type="idfolio"/>
                <part increase="1" value="-" type="string"/>
                <part increase="1" value="" type="unitfolio"/>
            </conductor_autonum>
        </conductors_autonums>
        <folio_autonums>
            <folio_autonum title="Folio">
                <part increase="1" value="" type="unit"/>
            </folio_autonum>
        </folio_autonums>
        <element_autonums freeze_new_elements="false" current_autonum="IEC symbols">
            <element_autonum formula="-%prefix%sequ_1" title="IEC symbols">
                <part increase="1" value="-" type="string"/>
                <part increase="1" value="" type="elementprefix"/>
                <part increase="1" value="" type="unit"/>
            </element_autonum>
        </element_autonums>
    </newdiagrams>
    <properties>
        <property name="drawing_standard">iec</property>
    </properties>
    <diagram titleblocktemplate="ISO7200 A3" titleblocktemplateCollection="embedded" cols="27" colsize="58" rows="13" rowsize="80" displaycols="true" displayrows="true" displayAt="bottom" folio="%id/%total" title="" auto_page_num="Folio" order="1" freezeNewElement="false" freezeNewConductor="false"/>
</project>
