<project version="0.100">
    <titleblocktemplates>
<titleblocktemplate name="ISO7200 A3">
    <information />
    <logos>
        </logos>
    <grid cols="r100%;50px;70px;165px;215px;35px;100px;35px;35px;" rows="15;15;15;15;">
        <field valign="center" row="0" colspan="1" fontsize="9" hadjust="true" col="1" name="department" displaylabel="false" align="center">
